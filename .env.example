# MediaHub Unify Tools - Environment Configuration
# Copy this file to .env and customize the values

# ===========================================
# User Configuration
# ===========================================
# Get your PUID and PGID by running: id $USER
PUID=1000
PGID=1000

# Timezone (find yours at https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=Europe/Paris

# ===========================================
# Paths Configuration
# ===========================================
# Configuration files location (on SD card or fast storage)
CONFIG_PATH=/opt/mediahub/config

# Download location (on external HDD)
DOWNLOAD_PATH=/mnt/media/downloads

# Media library location (on external HDD)
MEDIA_PATH=/mnt/media/library

# Backup location
BACKUP_PATH=/mnt/media/backups

# ===========================================
# VPN Configuration (Multi-Provider Support)
# ===========================================
# Supported providers: protonvpn, nordvpn, mullvad, surfshark, pia,
# expressvpn, cyberghost, ivpn, windscribe, airvpn, and 14+ more
# Full list: https://github.com/qdm12/gluetun-wiki/tree/main/setup/providers

# VPN Provider (default: protonvpn)
VPN_SERVICE_PROVIDER=protonvpn

# VPN Type (openvpn or wireguard)
VPN_TYPE=openvpn

# --- OpenVPN Authentication (for most providers) ---
# ProtonVPN: Get from https://account.protonvpn.com/account#openvpn
# NordVPN: Use service credentials from account dashboard
# Surfshark: Use service credentials
OPENVPN_USER=your_openvpn_username
OPENVPN_PASSWORD=your_openvpn_password

# --- Wireguard Authentication (for Mullvad, AirVPN, IVPN) ---
# Get these from your provider's account settings
WIREGUARD_PRIVATE_KEY=
WIREGUARD_PRESHARED_KEY=
WIREGUARD_ADDRESSES=

# --- Server Selection ---
# For most providers (use English names)
SERVER_COUNTRIES=Netherlands
# For PIA (Private Internet Access)
SERVER_REGIONS=
# For Mullvad (city-based)
SERVER_CITIES=

# --- Custom Config (for advanced users) ---
# Path to custom OpenVPN config (place .ovpn in config/gluetun/)
OPENVPN_CUSTOM_CONFIG=
# AirVPN specific
VPN_ENDPOINT_IP=
VPN_ENDPOINT_PORT=

# --- Legacy ProtonVPN variables (for backward compatibility) ---
PROTON_USER=your_openvpn_username
PROTON_PASS=your_openvpn_password
VPN_COUNTRY=Netherlands

# ===========================================
# Security
# ===========================================
# Pi-hole admin password
PIHOLE_PASSWORD=your_secure_password_here

# Jellyfin admin credentials (auto-generated during install or set manually)
JELLYFIN_USER=admin
JELLYFIN_PASSWORD=your_secure_password_here

# qBittorrent admin credentials
QBITTORRENT_USER=admin
QBITTORRENT_PASSWORD=adminadmin

# Code-Server (VSCode in Browser) password
CODE_SERVER_PASSWORD=your_secure_password_here

# ===========================================
# Network Configuration
# ===========================================
# Your local network subnet (for firewall rules)
LOCAL_SUBNET=192.168.1.0/24

# Static IP for Raspberry Pi (recommended)
RPI_IP=192.168.1.100

# ===========================================
# Optional Services
# ===========================================
# Enable/disable optional services (true/false)
ENABLE_PIHOLE=true
ENABLE_NETDATA=true
ENABLE_DUPLICATI=true
ENABLE_SCRUTINY=true

# ===========================================
# Installation Configuration
# ===========================================
# MediaHub installation directory
INSTALL_DIR=/opt/mediahub

# ===========================================
# Hardware Configuration
# ===========================================
# External HDD device (check with lsblk)
HDD_DEVICE=/dev/sda1

# Mount point for external HDD
HDD_MOUNT=/mnt/media

# Scrutiny disk monitoring (specific device to monitor)
# Can be auto-detected or set manually (e.g., /dev/sda)
SCRUTINY_DEVICE=/dev/sda

# ===========================================
# Performance Tuning
# ===========================================
# Maximum concurrent downloads
MAX_DOWNLOADS=3

# Jellyfin transcoding threads (RPi4 = 4 cores)
TRANSCODE_THREADS=2

# ===========================================
# *arr Suite API Keys (for Unpackerr)
# ===========================================
# Get these from each service: Settings > General > API Key
SONARR_API_KEY=your_sonarr_api_key
RADARR_API_KEY=your_radarr_api_key
LIDARR_API_KEY=your_lidarr_api_key
# READARR_API_KEY is commented as Readarr is disabled for ARM64 optimization
# READARR_API_KEY=your_readarr_api_key

# ===========================================
# Wireguard (Remote Access)
# ===========================================
# Your public IP or domain (auto = automatic detection)
WIREGUARD_SERVERURL=auto

# Port for Wireguard (must be open on router)
WIREGUARD_PORT=51820

# Number of client configs to generate
WIREGUARD_PEERS=3

# ===========================================
# Notifications
# ===========================================
# Watchtower notifications (optional)
# Format: discord://token@id or telegram://token@telegram?channels=@channel
# See: https://containrrr.dev/shoutrrr/services/overview/
WATCHTOWER_NOTIFICATION_URL=

# Notifiarr API Key (get from https://notifiarr.com)
NOTIFIARR_API_KEY=

# ===========================================
# Photoprism (Photo Gallery)
# ===========================================
# Admin credentials for Photoprism
PHOTOPRISM_ADMIN_USER=admin
PHOTOPRISM_ADMIN_PASSWORD=your_secure_password_here

# ===========================================
# Notification Services
# ===========================================
# Gotify server (self-hosted push notifications)
GOTIFY_USER=admin
GOTIFY_PASSWORD=your_secure_password_here

# Discord webhook URL (for notifications)
# Get from: Server Settings > Integrations > Webhooks > New Webhook
DISCORD_WEBHOOK_URL=

# Telegram bot token and chat ID
# Create bot: @BotFather > /newbot
# Get chat ID: Send message to bot, then visit https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email notifications (optional - uses mailrise SMTP relay)
NOTIFICATION_EMAIL=your_email@example.com

# SMTP settings for external email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=mediahub@localhost
