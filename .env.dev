# MediaHub Development Environment
# For local testing WITHOUT real VPN or external storage

# ===========================================
# User Configuration
# ===========================================
PUID=1000
PGID=1000
TZ=Europe/Paris

# ===========================================
# Local Dev Paths (uses local directories)
# ===========================================
INSTALL_DIR=/home/bricol/Documents/GitHub/mediahub-unify-tools
CONFIG_PATH=./dev-data/config
DOWNLOAD_PATH=./dev-data/downloads
MEDIA_PATH=./dev-data/library
BACKUP_PATH=./dev-data/backups

# ===========================================
# VPN Configuration (DISABLED for dev)
# ===========================================
VPN_SERVICE_PROVIDER=none
VPN_TYPE=none
OPENVPN_USER=
OPENVPN_PASSWORD=
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
SERVER_COUNTRIES=
SERVER_REGIONS=
SERVER_CITIES=

# Legacy variables
PROTON_USER=
PROTON_PASS=
VPN_COUNTRY=

# ===========================================
# Security (Dev passwords - NOT for production)
# ===========================================
PIHOLE_PASSWORD=devpassword123
JELLYFIN_USER=admin
JELLYFIN_PASSWORD=devpassword123
QBITTORRENT_USER=admin
QBITTORRENT_PASSWORD=devpassword123
PHOTOPRISM_ADMIN_USER=admin
PHOTOPRISM_ADMIN_PASSWORD=devpassword123
GOTIFY_USER=admin
GOTIFY_PASSWORD=devpassword123
MASTER_PASSWORD_HASH=dev_hash_not_secure

# ===========================================
# Network Configuration
# ===========================================
LOCAL_SUBNET=192.168.1.0/24
RPI_IP=127.0.0.1

# ===========================================
# Optional Services (minimal for dev)
# ===========================================
ENABLE_PIHOLE=false
ENABLE_NETDATA=true
ENABLE_DUPLICATI=false
ENABLE_SCRUTINY=false

# ===========================================
# Hardware Configuration (not used in dev)
# ===========================================
HDD_DEVICE=/dev/null
HDD_MOUNT=./dev-data
HARDWARE_MODE=full

# ===========================================
# Performance Tuning
# ===========================================
MAX_DOWNLOADS=1
TRANSCODE_THREADS=2

# ===========================================
# API Keys (dummy for dev)
# ===========================================
SONARR_API_KEY=dev_sonarr_key_placeholder
RADARR_API_KEY=dev_radarr_key_placeholder
LIDARR_API_KEY=dev_lidarr_key_placeholder
READARR_API_KEY=dev_readarr_key_placeholder

# ===========================================
# Feature Flags
# ===========================================
ENABLE_TV_KIOSK=false
ENABLE_HDMI_CEC=false
ENABLE_NOTIFICATIONS=false
ENABLE_MONITORING=true

# ===========================================
# Notifications (disabled for dev)
# ===========================================
WATCHTOWER_NOTIFICATION_URL=
NOTIFIARR_API_KEY=
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFICATION_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ===========================================
# Wireguard (disabled for dev)
# ===========================================
WIREGUARD_SERVERURL=auto
WIREGUARD_PORT=51820
WIREGUARD_PEERS=1
